#!/bin/bash
set -e

# Install Python dependencies if not already installed
pip3 install --no-cache-dir -r /usr/share/teslamate-abrp/requirements.txt

# Read options from Home Assistant config
CONFIG_PATH="/data/options.json"
USER_TOKEN=$(jq -r '.USER_TOKEN' "$CONFIG_PATH")
CAR_NUMBER=$(jq -r '.CAR_NUMBER' "$CONFIG_PATH")
MQTT_SERVER=$(jq -r '.MQTT_SERVER' "$CONFIG_PATH")
MQTT_USERNAME=$(jq -r '.MQTT_USERNAME' "$CONFIG_PATH")
MQTT_PASSWORD=$(jq -r '.MQTT_PASSWORD' "$CONFIG_PATH")
MQTT_PORT=$(jq -r '.MQTT_PORT' "$CONFIG_PATH")
CAR_MODEL=$(jq -r '.CAR_MODEL' "$CONFIG_PATH")
STATUS_TOPIC=$(jq -r '.STATUS_TOPIC' "$CONFIG_PATH")
TM2ABRP_DEBUG=$(jq -r '.TM2ABRP_DEBUG' "$CONFIG_PATH")
MQTT_TLS=$(jq -r '.MQTT_TLS' "$CONFIG_PATH")
MQTT_VERIFY_CERT=$(jq -r '.MQTT_VERIFY_CERT' "$CONFIG_PATH")
SKIP_LOCATION=$(jq -r '.SKIP_LOCATION' "$CONFIG_PATH")

# Run the main script with all options as environment variables
export USER_TOKEN CAR_NUMBER MQTT_SERVER MQTT_USERNAME MQTT_PASSWORD MQTT_PORT CAR_MODEL STATUS_TOPIC TM2ABRP_DEBUG MQTT_TLS MQTT_VERIFY_CERT SKIP_LOCATION
python3 /usr/share/teslamate-abrp/teslamate_mqtt2abrp.py
